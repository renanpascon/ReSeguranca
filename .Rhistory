library(plotly)
fig <- plotly::plot_ly(
data = plot_coords,
type = "scattermapbox",
mode = "lines",
lon = ~lon,
lat = ~lat,
group = ~group,
line = list(width = 1, color = "blue"),
fill = "toself",
fillcolor = "rgba(0, 100, 255, 0.2)"
) %>%
layout(
mapbox = list(
style = "carto-positron",
zoom = 4,
center = list(lat = mean(plot_coords$lat), lon = mean(plot_coords$lon))
),
margin = list(l = 0, r = 0, b = 0, t = 0)
) %>%
config(displayModeBar = FALSE)
