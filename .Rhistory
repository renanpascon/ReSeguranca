# Function to extract coordinates from MULTIPOLYGON or POLYGON
extract_coords <- function(sf_obj) {
coords_list <- lapply(1:nrow(sf_obj), function(i) {
geom <- sf_obj[i, ] %>% sf::st_geometry() %>% sf::st_coordinates()
data.frame(
lon = geom[, 1],
lat = geom[, 2],
CD_MUN = sf_obj[i, ]$CD_MUN  # for separating polygons
)
})
do.call(rbind, coords_list)
}
plot_coords <- extract_coords(shape_simple)
fig <- plot_ly(
y  =  plot_coords$lat,
x  =  plot_coords$long,
type = 'scattermapbox',
mode = 'markers',
showlegend = FALSE,
hoverinfo = "none")
fig <- plotly::plot_ly(
y  =  plot_coords$lat,
x  =  plot_coords$long,
type = 'scattermapbox',
mode = 'markers',
showlegend = FALSE,
hoverinfo = "none")
fig
fig
